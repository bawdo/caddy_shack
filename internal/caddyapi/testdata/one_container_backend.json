{
  "admin": { "listen": "0.0.0.0:2019" },
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [":443"],
          "routes": [
            {
              "match": [{ "host": ["app.test"] }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "app:3000" }] }]
            },
            {
              "match": [{ "host": ["*.app.test"] }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "app:3000" }] }]
            }
          ],
          "automatic_https": { "disable_redirects": false }
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          { "subjects": ["*.app.test", "app.test"], "issuers": [{ "module": "internal" }] }
        ]
      }
    }
  }
}
